# --- Local LLM (llama.cpp server, OpenAI-compatible /v1) ---
DEEPEGB_LLM_BASE_URL=http://127.0.0.1:8080/v1
DEEPEGB_LLM_API_KEY=sk-no-key-needed
DEEPEGB_LLM_MODEL=local

# Default provider used by the agent: "local" (recommended for Strix Halo),
# "anthropic", "openai", or "zai".
DEEPEGB_PROVIDER=local

# --- API fallbacks (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Z.AI GLM (OpenAI-compatible)
# See https://docs.z.ai/guides/llm/  ;  models include glm-4.5, glm-4.6,
# glm-4.7, glm-5, glm-5-turbo, glm-5.1.  glm-4.6 is a balanced default.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.6

# --- Local RAG ---
# Folder of PDFs/TeX/HTML/MD to index for retrieval. Built via
# `deepegb rag index`. The index itself lives in ~/.deepegb/rag_index/.
DEEPEGB_RAG_PATH=~/University/PhD/papers

# --- arXiv MCP server ---
# blazickjp/arxiv-mcp-server is the recommended default. The line below
# launches it via uvx (ephemeral venv); replace with your own command if
# you have a permanent install.
DEEPEGB_ARXIV_MCP_CMD=uvx arxiv-mcp-server --storage-path ~/.deepegb/arxiv_papers
